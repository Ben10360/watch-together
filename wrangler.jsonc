
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watch-together-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "WatchRoom"
      }
    ]
  },
  "exports": {
    "WatchRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
